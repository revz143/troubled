# Local Supabase defaults after `pnpm supabase:start`.
# Replace the key with the local anon/publishable key from `pnpm supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional local E2E credentials for a test user in your Supabase project.
E2E_SUPABASE_EMAIL=
