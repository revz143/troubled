# Copy this to .env.docker, then run:
# docker compose --env-file .env.docker up app

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For Supabase CLI running on the host machine through Docker Desktop.
# Replace the key with the local anon/publishable key from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-anon-or-publishable-key
